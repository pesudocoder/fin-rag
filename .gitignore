# Python
__pycache__/
*.py[cod]
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Secrets
.env

# Data (tracked as empty dirs via .gitkeep)
/data/raw/*
/data/processed/*
!/data/raw/.gitkeep
!/data/processed/.gitkeep
# Evidence trail: small, and referenced by RESULTS.md
!/data/processed/dataset_stats.json

# SEC filings: raw documents ignored, provenance manifest committed.
# The directory itself must be un-ignored first - git does not descend into an
# excluded directory, so a negation inside one it never visits has no effect.
!/data/raw/filings/
/data/raw/filings/*
!/data/raw/filings/manifest.json

# Embeddings, chunk payload and FAISS index (regenerable from the manifest)
/data/processed/embeddings/
/data/processed/chunks.json
/data/processed/faiss/

# Model checkpoints / serialized estimators
models/
# ~250MB each - listed explicitly even though models/ already covers them
models/distilbert_standard/
models/distilbert_weighted/
*.pt
*.bin
*.safetensors
*.ckpt
*.joblib

# FAISS / vector indexes
*.faiss
*.index

# Notebooks
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
